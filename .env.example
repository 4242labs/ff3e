# Copy to .env and fill in. .env is gitignored — never commit your token.

# Where your Firefly III lives, no trailing slash.
FIREFLY_III_URL=https://firefly.example.com

# Firefly III → Options → Profile → OAuth → Personal Access Tokens → Create.
# Read-only is all Entropy for Firefly III ever does with it.
FIREFLY_III_TOKEN=

# Extra days fetched on either side of a requested window so explicit settlement
# tags and paid card statements near a boundary remain available. Date and amount
# similarity alone never marks a projected occurrence as settled.
MATCH_DAYS=5

# Optional — only if your Firefly III sits behind a Cloudflare Access service
# auth. Both must be set to take effect; unset means no such headers are sent.
FIREFLY_CF_ACCESS_CLIENT_ID=
FIREFLY_CF_ACCESS_CLIENT_SECRET=

# Host port to serve on.
PORT=8000

# --- Web build-time flags (set when running `npm run build` in web/) ---
# VITE_BASE        public base path when the SPA is mounted under a subpath
#                  (default: ./). e.g. /entropy/
# VITE_API_BASE    forecast endpoint the SPA calls (default: api/forecast).
# VITE_TX_API_BASE transactions endpoint the Reports view calls
#                  (default: api/transactions).
# VITE_AUTH_RELOAD 1 to reload on an expired auth-proxy session (default: off).
